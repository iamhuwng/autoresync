#!/bin/sh
# Pre-commit hook to run tests on changed files
# 
# SETUP INSTRUCTIONS:
# 1. npm install husky --save-dev
# 2. npx husky init
# 3. Copy this to .husky/pre-commit (remove .sample extension)
# 4. chmod +x .husky/pre-commit (on Mac/Linux)

echo "🧪 Running tests on changed files..."

# Get list of changed test files
CHANGED_TEST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(test|spec)\.(ts|tsx|js|jsx)$')

if [ -n "$CHANGED_TEST_FILES" ]; then
  echo "Running tests for: $CHANGED_TEST_FILES"
  npm test -- --run $CHANGED_TEST_FILES
  
  if [ $? -ne 0 ]; then
    echo "❌ Tests failed. Commit blocked."
    exit 1
  fi
fi

# Get list of changed source files and find their tests
CHANGED_SRC_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' | grep -v -E '\.(test|spec)\.')

for file in $CHANGED_SRC_FILES; do
  # Find corresponding test file
  TEST_FILE=$(echo "$file" | sed 's/\.\(ts\|tsx\|js\|jsx\)$/.test.\1/')
  
  if [ -f "$TEST_FILE" ]; then
    echo "Running tests for: $TEST_FILE"
    npm test -- --run "$TEST_FILE"
    
    if [ $? -ne 0 ]; then
      echo "❌ Tests failed for $file. Commit blocked."
      exit 1
    fi
  fi
done

echo "✅ All tests passed!"
