rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isReadingPassageHomeworkType(data) {
      return data.materialType == 'reading-passage'
        || data.materialType == 'reading-passage-set';
    }

    function hasReadingPassageSnapshot(data) {
      return data.keys().hasAll(['readingPassageSnapshot'])
        && data.readingPassageSnapshot.passageMaterialId is string
        && data.readingPassageSnapshot.snapshotVersionId is string
        && data.readingPassageSnapshot.titleSnapshot is string
        && data.readingPassageSnapshot.questionCount is int;
    }

    function hasReadingPassageSet(data) {
      return data.keys().hasAll(['readingPassageSet'])
        && data.readingPassageSet.items is list
        && data.readingPassageSet.items.size() > 0;
    }

    function isValidReadingPassageHomeworkPayload(data) {
      return !isReadingPassageHomeworkType(data)
        || (
          data.materialType == 'reading-passage'
          && hasReadingPassageSnapshot(data)
          && !data.keys().hasAny(['readingPassageSet'])
        )
        || (
          data.materialType == 'reading-passage-set'
          && hasReadingPassageSet(data)
          && !data.keys().hasAny(['readingPassageSnapshot'])
        );
    }

    // Mode 2 Book Homework is a trusted-worker authority record. Firestore
    // rules deny browser writes and admit only the assignment/owner-scoped
    // Firebase service claim minted by the Homework Worker.
    function isBookHomework(data) {
      return data is map
        && (
          (
            data.keys().hasAny(['assignmentKind'])
            && data.assignmentKind is string
            && data.assignmentKind == 'book_activity_bundle'
          )
          || data.keys().hasAny(['bookManifest'])
        );
    }

    // Per-recipient Book authority capability. This is deliberately separate
    // from the compatibility-shell/RTDB `book_homework` claim.
    function isExactBookHomeworkAuthorityService(authorityId, assignmentId, ownerId) {
      return hasExactBookHomeworkAuthorityClaims()
        && request.auth.uid == ownerId
        && request.auth.token.book_homework_authority_authorityId == authorityId
        && request.auth.token.book_homework_authority_assignmentId == assignmentId
        && request.auth.token.book_homework_authority_ownerId == ownerId
        && isDeterministicBookHomeworkAuthorityId(authorityId, assignmentId);
    }

    function hasExactBookHomeworkAuthorityClaims() {
      return request.auth != null
        && request.auth.token.keys().hasAll([
          'book_homework_authority_service',
          'book_homework_authority_authorityId',
          'book_homework_authority_assignmentId',
          'book_homework_authority_ownerId'
        ])
        && request.auth.token.book_homework_authority_service == true;
    }

    function isExactBookHomeworkAuthorityGet(authorityId) {
      return hasExactBookHomeworkAuthorityClaims()
        && request.auth.uid == request.auth.token.book_homework_authority_ownerId
        && request.auth.token.book_homework_authority_authorityId == authorityId
        && isDeterministicBookHomeworkAuthorityId(
          authorityId,
          request.auth.token.book_homework_authority_assignmentId,
        )
        && (
          !exists(/databases/$(database)/documents/book_homework_authorities/$(authorityId))
          || resource.data.ownerId == request.auth.token.book_homework_authority_ownerId
        );
    }

    function isDeterministicBookHomeworkAuthorityId(authorityId, assignmentId) {
      return assignmentId is string
        && assignmentId.matches('^[A-Za-z0-9][A-Za-z0-9_:@-]{0,127}$')
        && authorityId is string
        && authorityId.matches('^' + assignmentId + '--[A-Za-z0-9][A-Za-z0-9_:@-]{0,127}--authority$');
    }

    function isBookHomeworkCompatibility(data) {
      return data is map
        && data.keys().hasAll(['assignmentKind', 'bookHomeworkCompatibility'])
        && data.assignmentKind == 'book_homework_compatibility'
        && data.bookHomeworkCompatibility is map;
    }

    function isExactBookHomeworkCompatibilityService(assignmentId, ownerId) {
      return hasExactBookHomeworkCompatibilityClaims()
        && isSafeBookHomeworkAssignmentId(assignmentId)
        && request.auth.uid == ownerId
        && request.auth.token.book_homework_compatibility_assignmentId == assignmentId
        && request.auth.token.book_homework_compatibility_ownerId == ownerId;
    }

    function hasExactBookHomeworkCompatibilityClaims() {
      return request.auth != null
        && request.auth.token.keys().hasAll([
          'book_homework_compatibility_service',
          'book_homework_compatibility_assignmentId',
          'book_homework_compatibility_ownerId'
        ])
        && request.auth.token.book_homework_compatibility_service == true;
    }

    function isExactBookHomeworkCompatibilityGet(assignmentId) {
      return hasExactBookHomeworkCompatibilityClaims()
        && isSafeBookHomeworkAssignmentId(assignmentId)
        && request.auth.uid == request.auth.token.book_homework_compatibility_ownerId
        && request.auth.token.book_homework_compatibility_assignmentId == assignmentId;
    }

    function isSafeBookHomeworkAssignmentId(assignmentId) {
      return assignmentId is string
        && assignmentId.matches('^[A-Za-z0-9][A-Za-z0-9_:@-]{0,127}$');
    }

    function isValidBookHomeworkCompatibilityProjection(data, assignmentId, ownerId) {
      return isBookHomeworkCompatibility(data)
        && data.keys().hasAll([
          'schemaVersion', 'assignmentKind', 'id', 'createdBy', 'createdAt', 'updatedAt',
          'materialId', 'materialTitle', 'materialType', 'materialSkill', 'title', 'target',
          'scheduling', 'config', 'visibility', 'archived', 'tags', 'bookHomeworkCompatibility'
        ])
        && data.keys().hasOnly([
          'schemaVersion', 'assignmentKind', 'id', 'createdBy', 'createdAt', 'updatedAt',
          'materialId', 'materialTitle', 'materialType', 'materialSkill', 'title', 'description',
          'target', 'scheduling', 'config', 'visibility', 'archived', 'tags', 'bookHomeworkCompatibility'
        ])
        && data.schemaVersion == 1
        && data.assignmentKind == 'book_homework_compatibility'
        && data.id == assignmentId
        && data.createdBy == ownerId
        && data.bookHomeworkCompatibility is map
        && data.bookHomeworkCompatibility.keys().hasAll([
          'schemaVersion', 'assignmentId', 'sourceSagaRevision', 'sourceFingerprint'
        ])
        && data.bookHomeworkCompatibility.keys().hasOnly([
          'schemaVersion', 'assignmentId', 'sourceSagaRevision', 'sourceFingerprint'
        ])
        && data.bookHomeworkCompatibility.schemaVersion == 1
        && data.bookHomeworkCompatibility.assignmentId == assignmentId
        && data.bookHomeworkCompatibility.sourceSagaRevision is int
        && data.bookHomeworkCompatibility.sourceSagaRevision >= 1
        && data.bookHomeworkCompatibility.sourceFingerprint is string
        && data.bookHomeworkCompatibility.sourceFingerprint.size() > 0
        && data.target is map
        && data.target.type == 'students'
        && data.target.studentIds is list
        && data.materialType == 'book'
        && data.materialSkill == 'mixed';
    }

    function isBookHomeworkCompatibilityReader(data) {
      return (
          request.auth != null
          && !isBookHomeworkCompatibilityServiceAuth()
          && isBookHomeworkCompatibility(data)
          && data.createdBy == request.auth.uid
        ) || (
          request.auth != null
          && !isBookHomeworkCompatibilityServiceAuth()
          && isBookHomeworkCompatibility(data)
          && data.keys().hasAll(['target'])
          && data.target is map
          && data.target.studentIds is list
          && data.target.studentIds.hasAny([request.auth.uid])
        );
    }

    function isBookHomeworkCompatibilityServiceAuth() {
      return hasExactBookHomeworkCompatibilityClaims();
    }

    function isLegalBookHomeworkCompatibilityUpdate() {
      return request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.assignmentKind == resource.data.assignmentKind
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.bookHomeworkCompatibility.schemaVersion
          == resource.data.bookHomeworkCompatibility.schemaVersion
        && request.resource.data.bookHomeworkCompatibility.assignmentId
          == resource.data.bookHomeworkCompatibility.assignmentId
        && request.resource.data.bookHomeworkCompatibility.sourceSagaRevision
          > resource.data.bookHomeworkCompatibility.sourceSagaRevision
        && request.resource.data.bookHomeworkCompatibility.sourceFingerprint is string
        && request.resource.data.bookHomeworkCompatibility.sourceFingerprint.size() > 0;
    }

    function isValidBookHomeworkAuthorityRecord(data, authorityId, assignmentId, ownerId) {
      return isBookHomework(data)
        && data.keys().hasAll([
          'assignmentId', 'assignmentKind', 'schemaVersion', 'ownerId', 'bookManifest',
          'schedule', 'studentExtensions', 'saga', 'visibility', 'revision', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'assignmentId', 'assignmentKind', 'schemaVersion', 'ownerId', 'bookManifest',
          'schedule', 'studentExtensions', 'saga', 'visibility', 'revision', 'createdAt', 'updatedAt',
          'activityPolicies', 'operations'
        ])
        && data.assignmentId == authorityId
        && data.assignmentKind == 'book_activity_bundle'
        && data.schemaVersion == 1
        && data.ownerId == ownerId
        && data.revision is int
        && data.revision >= 1
        && data.createdAt is string
        && data.updatedAt is string
        && data.bookManifest is map
        && data.bookManifest.ownerId == ownerId
        && data.bookManifest.context is map
        && data.bookManifest.context.recipientId is string
        && data.bookManifest.context.recipientId.matches('^[A-Za-z0-9][A-Za-z0-9_:@-]{0,127}$')
        && authorityId == assignmentId + '--' + data.bookManifest.context.recipientId + '--authority'
        && data.bookManifest.context.contextId == assignmentId
        && data.bookManifest.context.kind == 'homework'
        && data.bookManifest.context.entitlementBasis == 'assignment'
        && data.saga is map
        && data.saga.sagaId == assignmentId
        && data.saga.state in ['prepared', 'committed', 'compensating']
        && data.visibility is map
        && data.visibility.status == data.saga.state
        && data.visibility.manifestVersionId == data.bookManifest.manifestVersionId
        && data.visibility.pointerId == data.bookManifest.manifestVersionId
        && data.visibility.revision is int
        && data.visibility.revision >= 1
        && data.visibility.revision <= data.revision;
    }

    function isLegalBookHomeworkAuthorityUpdate() {
      return request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.assignmentId == resource.data.assignmentId
        && request.resource.data.assignmentKind == resource.data.assignmentKind
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.bookManifest.context == resource.data.bookManifest.context
        && request.resource.data.bookManifest.ownerId == resource.data.bookManifest.ownerId
        && request.resource.data.saga.sagaId == resource.data.saga.sagaId
        && request.resource.data.visibility.manifestVersionId == resource.data.visibility.manifestVersionId
        && request.resource.data.visibility.pointerId == resource.data.visibility.pointerId
        && request.resource.data.saga.state == request.resource.data.visibility.status
        && (
          request.resource.data.saga.state == resource.data.saga.state
          || (resource.data.saga.state == 'prepared'
            && (request.resource.data.saga.state == 'committed'
              || request.resource.data.saga.state == 'compensating'))
          || (resource.data.saga.state == 'compensating'
            && request.resource.data.saga.state == 'committed')
          || (resource.data.saga.state == 'committed'
            && request.resource.data.saga.state == 'compensating')
        );
    }

    function isCommittedBookHomework(data) {
      return isBookHomework(data)
        && data.keys().hasAll([
          'assignmentId', 'ownerId', 'bookManifest', 'schedule', 'studentExtensions',
          'saga', 'visibility', 'schemaVersion', 'revision', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'assignmentId', 'assignmentKind', 'schemaVersion', 'ownerId', 'bookManifest',
          'schedule', 'studentExtensions', 'saga', 'visibility', 'revision', 'createdAt',
          'updatedAt', 'operations'
        ])
        && data.assignmentId is string
        && data.ownerId is string
        && data.schemaVersion == 1
        && data.revision is int
        && data.revision >= 1
        && data.createdAt is string
        && data.updatedAt is string
        && data.bookManifest is map
        && data.bookManifest.keys().hasAll([
          'schemaVersion', 'assignmentKind', 'manifestVersionId', 'ownerId',
          'createdByCommandId', 'createdAt', 'bindingRevision', 'book', 'context',
          'selectedTarget', 'outline', 'scheduleRules', 'bindings', 'completion'
        ])
        && data.bookManifest.keys().hasOnly([
          'schemaVersion', 'assignmentKind', 'manifestVersionId', 'ownerId',
          'createdByCommandId', 'createdAt', 'bindingRevision', 'book', 'context',
          'selectedTarget', 'outline', 'scheduleRules', 'bindings', 'completion'
        ])
        && data.bookManifest.assignmentKind == 'book_activity_bundle'
        && data.bookManifest.schemaVersion == 1
        && data.bookManifest.manifestVersionId is string
        && data.bookManifest.ownerId == data.ownerId
        && data.bookManifest.createdByCommandId is string
        && data.bookManifest.createdAt is string
        && data.bookManifest.bindingRevision is int
        && data.bookManifest.book is map
        && data.bookManifest.book.keys().hasAll([
          'bookId', 'bookMode', 'bookRevision', 'publicationId', 'publicationRevision', 'publicationStatus'
        ])
        && data.bookManifest.book.keys().hasOnly([
          'bookId', 'bookMode', 'bookRevision', 'publicationId', 'publicationRevision', 'publicationStatus'
        ])
        && data.bookManifest.book.bookId is string
        && data.bookManifest.book.bookMode == 'pdf'
        && data.bookManifest.book.bookRevision is int
        && data.bookManifest.book.publicationId is string
        && data.bookManifest.book.publicationRevision is int
        && data.bookManifest.book.publicationStatus == 'published'
        && data.bookManifest.context is map
        && data.bookManifest.context.keys().hasAll(['contextId', 'recipientId', 'kind', 'entitlementBasis'])
        && data.bookManifest.context.keys().hasOnly(['contextId', 'recipientId', 'kind', 'entitlementBasis'])
        && data.bookManifest.context.contextId is string
        && data.bookManifest.context.recipientId is string
        && data.bookManifest.context.kind == 'homework'
        && data.bookManifest.context.entitlementBasis == 'assignment'
        && data.bookManifest.selectedTarget is map
        && data.bookManifest.selectedTarget.bookId is string
        && data.bookManifest.outline is list
        && data.bookManifest.scheduleRules is list
        && data.bookManifest.bindings is list
        && data.bookManifest.completion is map
        && data.bookManifest.completion.keys().hasAll([
          'aggregation', 'requiredBindingCount', 'excludedBindingCount', 'legacyScoreFields'
        ])
        && data.bookManifest.completion.keys().hasOnly([
          'aggregation', 'requiredBindingCount', 'excludedBindingCount', 'legacyScoreFields'
        ])
        && data.bookManifest.completion.requiredBindingCount is int
        && data.bookManifest.completion.excludedBindingCount is int
        && data.schedule is map
        && data.schedule.keys().hasAll(['schemaVersion', 'resolverVersion', 'finalDueAt', 'scheduleRules'])
        && data.schedule.keys().hasOnly(['schemaVersion', 'resolverVersion', 'availableFrom', 'finalDueAt', 'scheduleRules'])
        && data.schedule.schemaVersion == 1
        && data.schedule.resolverVersion == 1
        && data.schedule.finalDueAt is string
        && data.schedule.scheduleRules is list
        && data.studentExtensions is map
        && (!data.keys().hasAny(['operations']) || data.operations is map)
        && data.saga is map
        && data.saga.keys().hasAll(['sagaId', 'state', 'lastCommandId'])
        && data.saga.keys().hasOnly(['sagaId', 'state', 'lastCommandId'])
        && data.saga.sagaId is string
        && data.saga.lastCommandId is string
        && data.visibility is map
        && data.visibility.keys().hasAll(['status', 'pointerId', 'manifestVersionId', 'revision'])
        && data.visibility.keys().hasOnly(['status', 'pointerId', 'manifestVersionId', 'revision'])
        && data.visibility.status == 'committed'
        && data.saga.state == 'committed'
        && data.visibility.status == data.saga.state
        && data.visibility.pointerId is string
        && data.visibility.manifestVersionId is string
        && data.visibility.revision is int
        && data.visibility.revision >= 1
        && data.visibility.revision <= data.revision
        && data.visibility.pointerId == data.visibility.manifestVersionId
        && data.bookManifest.manifestVersionId == data.visibility.manifestVersionId;
    }

    function isBookHomeworkOwnerOrRecipient(data) {
      return data.ownerId == request.auth.uid
        || (
          data.bookManifest.keys().hasAll(['context'])
          && data.bookManifest.context.keys().hasAll(['recipientId'])
          && data.bookManifest.context.recipientId == request.auth.uid
        );
    }

    function isSafeHomeworkStats(stats) {
      return stats.keys().hasOnly([
          'totalAssigned',
          'started',
          'submitted',
          'lateSubmissions',
          'completionRate'
        ])
        && stats.totalAssigned is int
        && stats.started is int
        && stats.submitted is int
        && stats.lateSubmissions is int
        && (!stats.keys().hasAny(['completionRate'])
          || (stats.completionRate is int
            && stats.completionRate >= 0
            && stats.completionRate <= 100));
    }

    function isStudentStatsOnlyHomeworkUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats', 'updatedAt'])
        && !isBookHomework(resource.data)
        && !isBookHomework(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && isSafeHomeworkStats(resource.data.stats)
        && isSafeHomeworkStats(request.resource.data.stats)
        && request.resource.data.stats.totalAssigned == resource.data.stats.totalAssigned
        && request.resource.data.stats.started >= resource.data.stats.started
        && request.resource.data.stats.started <= resource.data.stats.started + 1
        && request.resource.data.stats.submitted >= resource.data.stats.submitted
        && request.resource.data.stats.submitted <= resource.data.stats.submitted + 1
        && request.resource.data.stats.lateSubmissions >= resource.data.stats.lateSubmissions
        && request.resource.data.stats.lateSubmissions <= resource.data.stats.lateSubmissions + 1
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && isValidReadingPassageHomeworkPayload(request.resource.data);
    }
    
    // Default rule: deny all access unless explicitly allowed below
    match /{document=**} {
      allow read, write: if false;
    }

    // API Keys Configuration
    match /settings/api_keys {
      // Only authenticated users can read (or specific admin roles depending on app structure)
      // Since it's client-side, we limit to authenticated users.
      // Ideally, a custom claim like `request.auth.token.admin == true` would be best,
      // but restricting to at least authenticated users is better than public access.
      allow read, write: if request.auth != null;
    }

    // Homework tag configuration
    match /app_config/homework_tags {
      allow read, write: if request.auth != null;
    }
    
    // Allow users to read and write their own data (assuming standard structure)
    // You should expand these rules to match your other collections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ═══════════════════════════════════════════════════════════════════════════
    // CORE COLLECTIONS — Hardened 2026-02-27 (previously: allow read, write: if auth != null)
    // ═══════════════════════════════════════════════════════════════════════════

    match /tests/{testId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /sessions/{sessionId} {
      // Sessions need broad read (students joining) and write (teachers creating, students updating)
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /results/{resultId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow delete: if false;  // Results are permanent academic records
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // DRAFT COLLECTIONS
    // ═══════════════════════════════════════════════════════════════════════════

    // IELTS Drafts (PRD-0022) — Hardened 2026-02-27 to match RTDB standard
    // Previously: allow read, write: if request.auth != null (no ownership check)
    match /drafts/{draftId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // HOMEWORK SYSTEM (PRD-0016) — Added 2026-02-27
    // Previously: NO RULES (default-deny blocked all operations)
    // ═══════════════════════════════════════════════════════════════════════════

    // Homework assignments — teachers create, students read their assigned ones
    match /homework_assignments/{assignmentId} {
      // A service read must be path/claim scoped and cannot depend on the
      // document existing. This is required for create-after-missing-read.
      allow get: if isExactBookHomeworkCompatibilityGet(assignmentId);
      // Raw Book authority documents are never browser-readable. Firestore
      // rules cannot validate arbitrary members of nested lists/maps; the
      // canonical Worker owns authenticated safe Book projections.
      allow read: if (
          request.auth != null
          && !isBookHomeworkCompatibilityServiceAuth()
          && !isBookHomework(resource.data)
          && !isBookHomeworkCompatibility(resource.data)
        ) || (
          isBookHomeworkCompatibilityReader(resource.data)
        );
      allow create: if (
          request.auth != null
          && !isBookHomework(request.resource.data)
          && !isBookHomeworkCompatibility(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && isValidReadingPassageHomeworkPayload(request.resource.data)
        ) || (
          isExactBookHomeworkCompatibilityService(assignmentId, request.resource.data.createdBy)
          && isValidBookHomeworkCompatibilityProjection(
            request.resource.data,
            assignmentId,
            request.resource.data.createdBy
          )
        );
      allow update: if (
        request.auth != null
        && !isBookHomework(resource.data)
        && !isBookHomework(request.resource.data)
        && !isBookHomeworkCompatibility(resource.data)
        && !isBookHomeworkCompatibility(request.resource.data)
        && (
          (
            resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy
            && isValidReadingPassageHomeworkPayload(request.resource.data)
          )
          || isStudentStatsOnlyHomeworkUpdate()
        ) || (
          isExactBookHomeworkCompatibilityService(assignmentId, resource.data.createdBy)
          && isValidBookHomeworkCompatibilityProjection(
            resource.data,
            assignmentId,
            resource.data.createdBy
          )
          && isValidBookHomeworkCompatibilityProjection(
            request.resource.data,
            assignmentId,
            resource.data.createdBy
          )
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.id == resource.data.id
          && isLegalBookHomeworkCompatibilityUpdate()
        ));
      allow delete: if request.auth != null
        && !isBookHomework(resource.data)
        && !isBookHomeworkCompatibility(resource.data)
        && resource.data.createdBy == request.auth.uid;
    }

    // Raw per-recipient Book authority. Browser access is denied: only the
    // exact owner-scoped Worker capability may address one document.
    match /book_homework_authorities/{authorityId} {
      allow get: if isExactBookHomeworkAuthorityGet(authorityId);
      allow list: if false;
      allow create: if isExactBookHomeworkAuthorityService(
          authorityId,
          request.resource.data.saga.sagaId,
          request.resource.data.ownerId
        )
        && isValidBookHomeworkAuthorityRecord(
          request.resource.data,
          authorityId,
          request.resource.data.saga.sagaId,
          request.resource.data.ownerId
        );
      allow update: if isExactBookHomeworkAuthorityService(
          authorityId,
          resource.data.saga.sagaId,
          resource.data.ownerId
        )
        && isValidBookHomeworkAuthorityRecord(
          resource.data,
          authorityId,
          resource.data.saga.sagaId,
          resource.data.ownerId
        )
        && isValidBookHomeworkAuthorityRecord(
          request.resource.data,
          authorityId,
          resource.data.saga.sagaId,
          resource.data.ownerId
        )
        && isLegalBookHomeworkAuthorityUpdate();
      allow delete: if false;
    }

    // Homework submissions — students create their own, teachers can reset
    // SECURITY FIX (2026-03-12): Previously `allow delete: if false` blocked the
    // teacher homework reset feature. Teachers (homework creators) need to delete
    // submissions when resetting a student's homework. Each submission now stores
    // a `teacherId` field (the homework creator's UID) set at creation time.
    match /homework_submissions/{submissionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (request.resource.data.studentId == request.auth.uid
            || (request.resource.data.teacherId == request.auth.uid
                && request.resource.data.administrativeImport.source == 'external-admin-import'
                && request.resource.data.administrativeImport.importedByTeacherId == request.auth.uid
                && get(/databases/$(database)/documents/homework_assignments/$(request.resource.data.homeworkId)).data.createdBy == request.auth.uid));
      // Students can update own submissions; teachers can update for grading
      // Third condition: allows teacher to backfill teacherId on old submissions
      // (created before teacherId was introduced) by writing their own UID.
      allow update: if request.auth != null
        && (resource.data.studentId == request.auth.uid
            || resource.data.teacherId == request.auth.uid
            || request.resource.data.teacherId == request.auth.uid);
      // Only the homework creator (teacher) can delete submissions (for reset)
      allow delete: if request.auth != null
        && resource.data.teacherId == request.auth.uid;
    }

    // Homework templates — teacher-owned
    match /homework_templates/{templateId} {
      allow read: if request.auth != null
        && resource.data.teacherId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.teacherId == request.auth.uid;
    }

    // Homework reminder status — system-managed per-homework tracking
    match /homework_reminder_status/{statusId} {
      allow read, write: if request.auth != null;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // STUDENT FEATURES (PRD-0016) — Added 2026-02-27
    // ═══════════════════════════════════════════════════════════════════════════

    // Student streaks — doc ID = studentId, students write own data only
    match /student_streaks/{studentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == studentId;
    }

    // Student groups — teacher-owned groups of students
    match /student_groups/{groupId} {
      allow read: if request.auth != null
        && resource.data.teacherId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.teacherId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // UTILITY COLLECTIONS — Added 2026-02-27
    // ═══════════════════════════════════════════════════════════════════════════

    // Parsing cache — ephemeral checkpoints for document parser
    match /parsingCache/{cacheId} {
      allow read, write: if request.auth != null;
    }

    // AI correction logs — append-only learning data
    match /correctionLogs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;  // Append-only audit trail
    }

    // Email queue (Firebase Extension trigger collection)
    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;  // Only Firebase Extension processes these
    }

    // Game sessions (Firestore mirror of RTDB)
    match /game_sessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // PRD-0027: THCS-THPT Draft Collection
    // Owner-only: teacher can only CRUD their own drafts.
    // SECURITY FIX (2026-02-27): Previously used combined `allow read, write` with
    // resource.data.userId — this silently blocked creates because resource.data is
    // null for new documents. Also, create had no ownership validation, allowing
    // any user to create drafts under another user's userId.
    // Fix follows the thcs_templates gold standard: separate create/read/update/delete.
    match /thcs_drafts/{draftId} {
      // Read: only the owner can read their own drafts
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Create: must be authenticated AND the userId in the new document must match the caller
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      // Update: only the owner can update (resource.data exists for existing docs)
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Delete: only the owner can delete
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // PRD-0027: THCS-THPT Library Collection
    // Read: any authenticated user (browse public library).
    // Write: only the creator or super_admin.
    // SECURITY FIX (2026-02-27): Previously combined `allow write` checked
    // resource.data.createdBy (null on create), and `allow create` was wide open
    // (no createdBy validation — any user could impersonate another).
    // Fix follows the thcs_templates pattern with explicit create/update/delete.
    match /thcs_library/{testId} {
      // Read: any authenticated user can browse the library
      allow read: if request.auth != null;

      // Create: must be authenticated AND createdBy must equal the caller's UID
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;

      // Update: only the original creator or super_admin
      allow update: if request.auth != null
        && (resource.data.createdBy == request.auth.uid
            || request.auth.token.role == 'super_admin');

      // Delete: only the original creator or super_admin
      allow delete: if request.auth != null
        && (resource.data.createdBy == request.auth.uid
            || request.auth.token.role == 'super_admin');
    }



    // PRD-0029 Phase 3 Task 7.1: THCS Test Templates Collection
    match /thcs_templates/{templateId} {
      allow read: if request.auth != null && (
        resource.data.isPublic == true || resource.data.ownerId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // PRD-0029 Phase 3 Task 4.4: Linked Tests Sub-collection
    match /users/{userId}/thcs_linked_tests/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // IELTS WRITING SYSTEM (PRD-0030) — Added 2026-02-28
    // ═══════════════════════════════════════════════════════════════════════════

    // Writing submissions — broad authenticated reads keep grading queue queries compatible.
    // Updates still require the student owner or teacher-linked grading metadata.
    function isAssignedWritingTeacher(submissionId) {
      return get(/databases/$(database)/documents/writing_submissions/$(submissionId)).data.context.assigningTeacherId == request.auth.uid
        || get(/databases/$(database)/documents/writing_submissions/$(submissionId)).data.context.selectedTeacherId == request.auth.uid;
    }

    match /writing_submissions/{submissionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.studentId == request.auth.uid
            || resource.data.context.assigningTeacherId == request.auth.uid
            || resource.data.context.selectedTeacherId == request.auth.uid
            || request.resource.data.context.assigningTeacherId == request.auth.uid
            || request.resource.data.context.selectedTeacherId == request.auth.uid
            || request.resource.data.grading.teacherId == request.auth.uid);
      allow delete: if false;  // Submissions are permanent records
    }

    // Writing test drafts — teacher-owned CRUD
    match /writing_drafts/{draftId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // [GAP-02] User settings — per-user private settings (annotation categories, etc.)
    // Private grading drafts. Assigned teachers can read/update/delete so the
    // discard-and-take-over workflow is possible without exposing the draft to students.
    match /writing_grading_drafts/{submissionId} {
      allow get: if request.auth != null && (
        isAssignedWritingTeacher(submissionId)
        || (exists(/databases/$(database)/documents/writing_grading_drafts/$(submissionId))
            && resource.data.ownerTeacherId == request.auth.uid)
      );
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerTeacherId == request.auth.uid
        && isAssignedWritingTeacher(submissionId);
      allow update, delete: if request.auth != null && (
        resource.data.ownerTeacherId == request.auth.uid
        || isAssignedWritingTeacher(submissionId)
      );
    }

    match /writing_grading_ai_cache/{submissionId} {
      allow get: if request.auth != null && isAssignedWritingTeacher(submissionId);
      allow list: if false;
      allow create: if request.auth != null
        && isAssignedWritingTeacher(submissionId);
      allow update: if request.auth != null
        && isAssignedWritingTeacher(submissionId);
      allow delete: if false;

      match /generation_runs/{runId} {
        allow get: if request.auth != null && isAssignedWritingTeacher(submissionId);
        allow list: if false;
        allow create, update: if request.auth != null
          && isAssignedWritingTeacher(submissionId);
        allow delete: if false;
      }
    }

    match /users/{userId}/settings/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
