{
  "name": "kahoot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/harness/run-tool.mjs vite . build && node scripts/check-bundle-budget.mjs",
    "deploy:hosting": "npm run build && node scripts/harness/run-tool.mjs firebase . deploy --only hosting:kahut1",
    "lint": "eslint . && npm run lint:mantine",
    "lint:mantine": "node scripts/check-mantine-boundary.mjs",
    "preview": "vite preview",
    "test": "node scripts/harness/run-tool.mjs vitest . run",
    "test:book-notifications": "node scripts/harness/run-tool.mjs vitest . run --config vitest.book-notification.config.mjs",
    "test:scripts": "npm run test:scripts:node && npm run test:scripts:vitest",
    "test:scripts:node": "node --test scripts/__tests__/branch-doctor.test.mjs scripts/__tests__/check-assessment-unification-guardrails.test.mjs scripts/__tests__/check-mantine-boundary.test.mjs scripts/__tests__/end-active-sessions.test.mjs scripts/__tests__/prd0062b-dormant-plan.test.mjs scripts/__tests__/run-security-tests.test.mjs scripts/__tests__/notification-migration.test.mjs scripts/__tests__/windows-arm64-harness.test.mjs",
    "test:harness": "node --test scripts/__tests__/windows-arm64-harness.test.mjs",
    "test:scripts:vitest": "node scripts/harness/run-tool.mjs vitest . run --config vitest.scripts.config.ts",
    "test:r2": "npm --prefix r2-backup-worker test",
    "test:prd0062-retirement": "node scripts/harness/run-tool.mjs firebase . emulators:exec --only database \"node node_modules/vitest/vitest.mjs run src/__tests__/security/prd0062RetiredDataQuarantineFirebaseRules.emulator.test.ts --passWithNoTests=false --maxWorkers=1\"",
    "test:all": "npm run test:prd0062-retirement && npm run test && npm run test:scripts && npm run test:r2",
    "check:utf8": "node scripts/check-utf8.mjs",
    "check:utf8:staged": "node scripts/check-utf8.mjs --staged",
    "check:utf8:all": "node scripts/check-utf8.mjs --tracked",
    "branch:doctor": "node scripts/branch-doctor.mjs",
    "sessions:end-active": "node scripts/end-active-sessions.mjs",
    "materials:inspect-retired": "node scripts/harness/run-tool.mjs vite-node . --mode test scripts/inspect-retired-materials.ts",
    "materials:purge-retired": "node scripts/harness/run-tool.mjs vite-node . --mode test scripts/purge-retired-materials.ts",
    "backfill:ielts-feedback": "node scripts/harness/run-tool.mjs vite-node . --mode test scripts/backfill-ielts-feedback.ts",
    "backfill:reading-v2-passages": "node scripts/harness/run-tool.mjs vite-node . --mode test scripts/reading-v2-full-test-passage-backfill.ts",
    "repair:material-catalog": "node scripts/harness/run-tool.mjs vite-node . --mode test scripts/material-catalog-repair.ts",
    "repair:material-summaries": "node scripts/harness/run-tool.mjs vite-node . --mode test --script scripts/material-summary-reconciliation.ts",
    "repair:reading-v2-test-bridges": "node scripts/harness/run-tool.mjs vite-node . --mode test scripts/reading-v2-test-bridge-repair.ts",
    "reading-v2:auto-v4-clippings-e2e": "node scripts/harness/run-tool.mjs vite-node . --mode test scripts/reading-v2-auto-v4-clippings-e2e.ts",
    "test:e2e": "cross-env VITE_FIREBASE_API_KEY=dummy VITE_FIREBASE_AUTH_DOMAIN=dummy VITE_FIREBASE_DATABASE_URL=https://dummy.firebaseio.com VITE_FIREBASE_PROJECT_ID=dummy VITE_FIREBASE_STORAGE_BUCKET=dummy VITE_FIREBASE_MESSAGING_SENDER_ID=dummy VITE_FIREBASE_APP_ID=dummy node scripts/harness/run-tool.mjs playwright . test --reporter=json > report.json",
    "harness:contract": "node scripts/harness/run-tool.mjs --contract",
    "harness:authority": "node scripts/harness/skill-authority.mjs",
    "harness:doctor": "node scripts/harness/run-tool.mjs --doctor .",
    "harness:doctor:cloudflare": "node scripts/harness/run-tool.mjs --doctor cloudflare",
    "test:security": "node scripts/run-security-tests.js",
    "test:prd0062:legacy-backup-recovery": "node scripts/harness/run-tool.mjs vitest . run --config vitest.config.ts src/__tests__/prd0062-legacy-backup-recovery.test.ts",
    "security:install-hooks": "cp scripts/pre-commit-security.sh .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "enforce": "node scripts/pre-commit-enforcement.js",
    "enforce:check": "node scripts/pre-commit-enforcement.js --check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@google/generative-ai": "^0.24.1",
    "@mantine/core": "^8.3.5",
    "@mantine/form": "^8.3.5",
    "@mantine/hooks": "^8.3.5",
    "@mantine/notifications": "^8.3.13",
    "@tabler/icons-react": "^3.35.0",
    "@tiptap/extension-bold": "^3.20.0",
    "@tiptap/extension-bullet-list": "^3.20.0",
    "@tiptap/extension-color": "^3.20.0",
    "@tiptap/extension-highlight": "^3.20.0",
    "@tiptap/extension-italic": "^3.20.0",
    "@tiptap/extension-ordered-list": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-text-style": "^3.20.0",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "antigravity-sdk": "^1.6.0",
    "aws4fetch": "^1.0.20",
    "bootstrap": "^5.3.8",
    "firebase": "^12.4.0",
    "groq-sdk": "^0.34.0",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jsonrepair": "^3.13.1",
    "jspdf": "^4.0.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^5.4.296",
    "perfect-freehand": "^1.2.2",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.1.1",
    "react-bootstrap": "^2.10.10",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.1.1",
    "react-floating-action-button": "^1.0.5",
    "react-resizable": "^3.0.5",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.2.1",
    "seedrandom": "^3.0.5",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.58.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/seedrandom": "^3.0.8",
    "@vitejs/plugin-react": "^5.0.4",
    "baseline-browser-mapping": "^2.9.14",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "firebase-tools": "^15.11.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "msw": "^2.12.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "terser": "^5.44.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.1.10",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
