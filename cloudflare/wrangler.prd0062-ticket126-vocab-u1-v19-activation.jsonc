  "account_id": "e41db829dabe9993f03674afdfd56510",
  "main": "worker.js",
  "compatibility_date": "2026-01-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
