      "namespace_id": "205512",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "migrations": [
    {
      "tag": "v1-upload-grant-replay-ledger",
      "new_sqlite_classes": ["UploadGrantReplayLedger"]
    },
    { "tag": "v4-prd0062-prd0062b-retirement" }
