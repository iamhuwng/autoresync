{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luyentap-book-source-reconciliation-preview",
  "main": "src/book-source-worker/reconciliation-worker.ts",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "account_id": "e41db829dabe9993f03674afdfd56510",
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "BOOK_SOURCE_UPLOAD_ACCOUNT_ID": "book_b2_primary",
    "BOOK_SOURCE_CAPACITY_ACCOUNT_ID": "book_b2_primary",
    "BOOK_SOURCE_CAPACITY_ENVIRONMENT": "staging",
    "BOOK_SOURCE_CAPACITY_MAX_PROVIDER_PAGES": "8",
    "BOOK_SOURCE_RECONCILIATION_LEASE_OWNER": "prd0062-preview-reconciler",
    "BOOK_SOURCE_RECONCILIATION_DIAGNOSTICS": "enabled",
    "FIREBASE_DATABASE_URL": "https://temp-a1437-default-rtdb.firebaseio.com",
    "FIREBASE_PROJECT_ID": "temp-a1437",
    "BOOK_SOURCE_FIREBASE_SERVICE_ACCOUNT_EMAIL": "book-source-worker-runtime@temp-a1437.iam.gserviceaccount.com",
    "BOOK_SOURCE_B2_ENDPOINT": "https://s3.us-west-004.backblazeb2.com",
    "BOOK_SOURCE_B2_REGION": "us-west-004",
    "BOOK_SOURCE_B2_STORAGE_LOCATION_ID": "b2_book_primary",
    "BOOK_SOURCE_B2_PRIVATE_BUCKET_NAME": "bookpdf",
    "BOOK_SOURCE_B2_OBJECT_KEY_PREFIX": "book-source/prd0062-preview-20260729/",
    "BOOK_SOURCE_CONTROL_ALLOWED_ORIGIN": "http://localhost:5173"
  }

  // Deployment-only secret bindings. Never commit values.
  // BOOK_SOURCE_RECONCILIATION_STATE
  // BOOK_SOURCE_RECONCILIATION_ACTION_STATE
  // BOOK_SOURCE_RECONCILIATION_SCHEDULE_STATE
  // BOOK_SOURCE_FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY
  // BOOK_SOURCE_B2_PRIVATE_BUCKET_ID
  // BOOK_SOURCE_B2_DELETE_APPLICATION_KEY_ID
  // BOOK_SOURCE_B2_DELETE_APPLICATION_KEY
  // BOOK_SOURCE_B2_METADATA_APPLICATION_KEY_ID
  // BOOK_SOURCE_B2_METADATA_APPLICATION_KEY
  // BOOK_SOURCE_CAPACITY_PROBE_STATE
  // BOOK_SOURCE_CAPACITY_PROBE_TOKEN
  // BOOK_SOURCE_CAPACITY_CURSOR_KEY
  // BOOK_SOURCE_B2_CAPACITY_APPLICATION_KEY_ID
  // BOOK_SOURCE_B2_CAPACITY_APPLICATION_KEY
}
