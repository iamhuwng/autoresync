    "BOOK_COMPONENT_PDF_PUBLICATION_ROUTES_ENABLED": "enabled",
    "BOOK_COMPONENT_PDF_PUBLICATION_ENABLED": "true",
    "BOOK_TEACHER_ASSEMBLY_DOCUMENT_ROUTES_ENABLED": "enabled",
    "BOOK_DELIVERY_READ_ROUTES_ENABLED": "enabled",
    "BOOK_DOCUMENT_DELIVERY_ROUTES_ENABLED": "enabled",
    "BOOK_RUNTIME_LAUNCH_ROUTES_ENABLED": "enabled",
    "BOOK_RUNTIME_ROUTES_ENABLED": "enabled",
    "BOOK_HOMEWORK_ROUTES_ENABLED": "enabled",
    "BOOK_HOMEWORK_READ_ROUTES_ENABLED": "enabled",
    "BOOK_HOMEWORK_COMPLETION_PROJECTION_ENABLED": "enabled",
    "BOOK_RESULT_READ_ROUTES_ENABLED": "enabled",
    "BOOK_RESULT_PROJECTION_ENABLED": "enabled",
    "BOOK_EVALUATION_HISTORY_ROUTES_ENABLED": "enabled",
    "BOOK_COURSE_PLACEMENT_ROUTES_ENABLED": "enabled",
    "BOOK_SOURCE_UPLOAD_ACCOUNT_ID": "book_oci_primary",
    "BOOK_SOURCE_CONTROL_ALLOWED_ORIGIN": "https://kahut1.web.app,https://hocthem.net,https://www.hocthem.net,https://app.hocthem.net,https://kahoot.hocthem.net,https://portal.hocthem.net,https://mstu.work,https://app.mstu.work,https://kahoot.mstu.work,https://portal.mstu.work,https://temp-a1437.web.app,https://temp-a1437.firebaseapp.com",
    "BOOK_SOURCE_OCI_PROVIDER_STATE": "enabled",
