{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luyentap-book-pdf-prod",
  "main": "worker.js",
  "compatibility_date": "2026-01-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "205512",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "UPLOAD_GRANT_REPLAY_LEDGER", "class_name": "UploadGrantReplayLedger" }]
  },
  "migrations": [
    { "tag": "v1-upload-grant-replay-ledger", "new_sqlite_classes": ["UploadGrantReplayLedger"] },
    { "tag": "v4-prd0062-prd0062b-retirement" }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "temp-a1437",
    "FIREBASE_DB_URL": "https://temp-a1437-default-rtdb.firebaseio.com",
    "PUBLIC_URL": "https://pub-9785039d4a7e4f76b2446f9fae6b2ca1.r2.dev",
    "BOOK_ACTIVITY_AUTHORING_ROUTES_ENABLED": "enabled",
    "BOOK_ASSEMBLY_ROUTES_ENABLED": "enabled",
    "BOOK_ASSEMBLY_MUTATIONS_ENABLED": "true",
    "BOOK_ASSEMBLY_PREVIEW_REGISTRY_VERSION": "activity-renderer-manifest-v1@sha256:f5b4139e1883ee2d288933f0d168bd9c5a54fce7636668a99075ea208ac1274f",
    "BOOK_FULL_PDF_PUBLICATION_ROUTES_ENABLED": "enabled",
