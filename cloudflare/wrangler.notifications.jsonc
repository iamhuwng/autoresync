{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luyentap-notification-command",
  "account_id": "e41db829dabe9993f03674afdfd56510",
  "main": "notification-command-worker.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/2 * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "NOTIFICATION_RETRY_EXECUTOR", "class_name": "NotificationRetryExecutor" }]
  },
  "migrations": [{ "tag": "v1-notification-retry-executor", "new_sqlite_classes": ["NotificationRetryExecutor"] }],
  "ratelimits": [
    {
      "name": "NOTIFICATION_RATE_LIMITER",
      "namespace_id": "205512",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "temp-a1437",
    "NOTIFICATION_RETRY_BATCH": "class-homework",
    "FIREBASE_DB_URL": "https://temp-a1437-default-rtdb.firebaseio.com",
    "NOTIFICATION_COMMAND_SERVICE_IDENTITY": "notification-command-runtime@temp-a1437.iam.gserviceaccount.com"
  }
}
