{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luyentap-qualification-upload-signer",
  "main": "worker.js",
  "compatibility_date": "2026-01-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "r2_buckets": [
    { "binding": "R2_BUCKET", "bucket_name": "luyentap-qualification-media" },
    { "binding": "LISTENING_AUDIO_BUCKET", "bucket_name": "luyentap-qualification-listening-audio" }
  ],
  "ratelimits": [
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "205514",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "UPLOAD_GRANT_REPLAY_LEDGER", "class_name": "UploadGrantReplayLedger" }]
  },
  "migrations": [
    { "tag": "v1-upload-grant-replay-ledger", "new_sqlite_classes": ["UploadGrantReplayLedger"] },
    { "tag": "v4-prd0062-prd0062b-retirement" }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "luyentap-pdf-qa-20261021",
    "FIREBASE_DB_URL": "https://luyentap-pdf-qa-20261021-default-rtdb.asia-southeast1.firebasedatabase.app",
    "PUBLIC_URL": "https://luyentap-qualification-media.r2.dev",
    "STUDENT_AUTH_ROUTES_ENABLED": "enabled",
    "SPARE_ALLOWED_LOCALHOST_PORTS": "5173-5182",
    "STUDENT_AUTH_ALLOWED_ORIGINS": "https://luyentap-pdf-qa-20261021.web.app,https://luyentap-pdf-qa-20261021--qualification.web.app,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178,http://localhost:5179,http://localhost:5180,http://localhost:5181,http://localhost:5182",
    "BOOK_ACTIVITY_AUTHORING_ROUTES_ENABLED": "enabled",
    "BOOK_ASSEMBLY_ROUTES_ENABLED": "enabled",
    "BOOK_ASSEMBLY_MUTATIONS_ENABLED": "true",
    "BOOK_ASSEMBLY_PREVIEW_REGISTRY_VERSION": "activity-renderer-manifest-v1@sha256:f5b4139e1883ee2d288933f0d168bd9c5a54fce7636668a99075ea208ac1274f",
    "BOOK_FULL_PDF_PUBLICATION_ROUTES_ENABLED": "enabled",
    "BOOK_FULL_PDF_PUBLICATION_ENABLED": "true",
    "BOOK_COMPONENT_PDF_PUBLICATION_ROUTES_ENABLED": "enabled",
    "BOOK_COMPONENT_PDF_PUBLICATION_ENABLED": "true",
    "BOOK_TEACHER_ASSEMBLY_DOCUMENT_ROUTES_ENABLED": "enabled",
    "BOOK_DELIVERY_READ_ROUTES_ENABLED": "enabled",
    "BOOK_DOCUMENT_DELIVERY_ROUTES_ENABLED": "enabled",
    "BOOK_RUNTIME_LAUNCH_ROUTES_ENABLED": "enabled",
    "BOOK_RUNTIME_ROUTES_ENABLED": "enabled",
    "BOOK_HOMEWORK_ROUTES_ENABLED": "enabled",
    "BOOK_HOMEWORK_READ_ROUTES_ENABLED": "enabled",
    "BOOK_HOMEWORK_COMPLETION_PROJECTION_ENABLED": "enabled",
    "BOOK_RESULT_READ_ROUTES_ENABLED": "enabled",
    "BOOK_RESULT_PROJECTION_ENABLED": "enabled",
    "BOOK_EVALUATION_HISTORY_ROUTES_ENABLED": "enabled",
    "BOOK_COURSE_PLACEMENT_ROUTES_ENABLED": "enabled",
    "BOOK_SOURCE_UPLOAD_ACCOUNT_ID": "book_oci_primary",
    "BOOK_SOURCE_CONTROL_ALLOWED_ORIGIN": "http://localhost:5173,http://localhost:5174,https://luyentap-pdf-qa-20261021.web.app",
    "BOOK_SOURCE_OCI_PROVIDER_STATE": "enabled",
    "BOOK_SOURCE_OCI_ENDPOINT": "https://axgsodluzsdz.compat.objectstorage.ap-singapore-1.oraclecloud.com",
    "BOOK_SOURCE_OCI_REGION": "ap-singapore-1",
    "BOOK_SOURCE_OCI_STORAGE_LOCATION_ID": "oci_book_primary",
    "BOOK_SOURCE_OCI_PRIVATE_BUCKET_NAME": "luyentap-bookpdf-qa",
    "BOOK_SOURCE_OCI_OBJECT_KEY_PREFIX": "book-source/qualification-qa/",
    "BOOK_SOURCE_UPLOAD_SERVICE_IDENTITY": "book-source@luyentap-pdf-qa-20261021.iam.gserviceaccount.com",
    "BOOK_ASSEMBLY_SERVICE_IDENTITY": "book-assembly@luyentap-pdf-qa-20261021.iam.gserviceaccount.com",
    "BOOK_ACTIVITY_AUTHORING_SERVICE_IDENTITY": "book-authoring@luyentap-pdf-qa-20261021.iam.gserviceaccount.com",
    "BOOK_DELIVERY_SERVICE_IDENTITY": "book-delivery@luyentap-pdf-qa-20261021.iam.gserviceaccount.com",
    "BOOK_HOMEWORK_SERVICE_IDENTITY": "book-homework@luyentap-pdf-qa-20261021.iam.gserviceaccount.com",
    "BOOK_RUNTIME_SERVICE_IDENTITY": "book-runtime@luyentap-pdf-qa-20261021.iam.gserviceaccount.com",
    "BOOK_RESULT_READ_SERVICE_IDENTITY": "book-result-read@luyentap-pdf-qa-20261021.iam.gserviceaccount.com",
    "BOOK_ACTIVITY_EVALUATION_SERVICE_IDENTITY": "book-evaluation@luyentap-pdf-qa-20261021.iam.gserviceaccount.com"
  },
  "secrets": {
    "required": [
      "FIREBASE_WEB_API_KEY",
      "UPLOAD_GRANT_SECRET",
      "BOOK_SOURCE_UPLOAD_GOOGLE_SA_KEY",
      "BOOK_ASSEMBLY_GOOGLE_SA_KEY",
      "BOOK_ACTIVITY_AUTHORING_GOOGLE_SA_KEY",
      "BOOK_DELIVERY_GOOGLE_SA_KEY",
      "BOOK_HOMEWORK_GOOGLE_SA_KEY",
      "BOOK_RUNTIME_GOOGLE_SA_KEY",
      "BOOK_RESULT_READ_GOOGLE_SA_KEY",
      "BOOK_ACTIVITY_EVALUATION_GOOGLE_SA_KEY",
      "BOOK_SOURCE_OCI_ACCESS_KEY_ID",
      "BOOK_SOURCE_OCI_SECRET_ACCESS_KEY"
    ]
  }
}
