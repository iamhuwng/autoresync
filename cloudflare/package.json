{
  "name": "r2-upload-signer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node ../scripts/harness/run-tool.mjs vitest . run",
    "generate:prd0062:118-rules": "node --experimental-transform-types scripts/generate-prd0062-118-rules.mjs",
    "test:security:red": "node scripts/run-insecure-baseline.mjs",
    "test:security:green": "node scripts/run-hardened-negative-suite.mjs",
    "verify:r2-lifecycle": "node scripts/verify-r2-lifecycle-config.mjs r2-lifecycle.temp-24h.json",
    "check": "node ../scripts/harness/run-tool.mjs wrangler . deploy --dry-run",
    "local": "node ../scripts/harness/run-tool.mjs wrangler . dev",
    "dev": "node ../scripts/harness/run-tool.mjs wrangler . dev",
    "deploy": "node ../scripts/harness/run-tool.mjs wrangler . deploy",
    "deployed-status": "node ../scripts/harness/run-tool.mjs wrangler . deployments status --name r2-upload-signer --json",
    "version-list": "node ../scripts/harness/run-tool.mjs wrangler . versions list --name r2-upload-signer --json",
    "version-pin": "node ../scripts/harness/run-tool.mjs wrangler . versions deploy",
    "rollback": "node ../scripts/harness/run-tool.mjs wrangler . rollback"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@cloudflare/workers-types": "^4.20260620.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  },
  "dependencies": {
    "jose": "^6.2.3"
  }
}
