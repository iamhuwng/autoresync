{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "r2-upload-signer",
  "main": "worker.js",
  "compatibility_date": "2026-01-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "audio.hocthem.net",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "kahoot-media"
    },
    {
      "binding": "LISTENING_AUDIO_BUCKET",
      "bucket_name": "luyentap-listening-audio-private"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "UPLOAD_GRANT_REPLAY_LEDGER",
        "class_name": "UploadGrantReplayLedger"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "205512",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1-upload-grant-replay-ledger",
      "new_sqlite_classes": [
        "UploadGrantReplayLedger"
      ]
    },
    {
      "tag": "v4-prd0062-prd0062b-retirement"
    }
  ],
  "vars": {
    "EXTERNAL_AUDIO_ROUTES_ENABLED": "enabled",
    "EXTERNAL_AUDIO_ENVIRONMENT": "production",
    "EXTERNAL_AUDIO_DRAFTS_ENABLED": "enabled",
    "EXTERNAL_AUDIO_PRIVATE_HOMEWORK_ENABLED": "enabled",
    "EXTERNAL_AUDIO_PUBLIC_LISTENING_ENABLED": "enabled",
    "EXTERNAL_AUDIO_THCS_ENABLED": "enabled",
    "EXTERNAL_AUDIO_UPLOAD_ROLLOUT": "enabled",
    "EXTERNAL_AUDIO_UPLOAD_ROLLBACK": "disabled",
    "EXTERNAL_AUDIO_STORE_PROJECT_ID": "luyentap-audio-prod",
    "EXTERNAL_AUDIO_STORE_DATABASE_URL": "https://luyentap-audio-prod-default-rtdb.asia-southeast1.firebasedatabase.app",
    "EXTERNAL_AUDIO_PROXY_ORIGIN": "https://audio.hocthem.net",
    "STUDENT_AUTH_ROUTES_ENABLED": "enabled",
    "STUDENT_AUTH_ALLOWED_ORIGINS": "https://kahut1.web.app,https://hocthem.net,https://www.hocthem.net,https://app.hocthem.net,https://kahoot.hocthem.net,https://portal.hocthem.net,https://mstu.work,https://app.mstu.work,https://kahoot.mstu.work,https://portal.mstu.work,https://temp-a1437.web.app,https://temp-a1437.firebaseapp.com",
    "BOOK_HOMEWORK_SERVICE_IDENTITY": "book-homework-runtime@temp-a1437.iam.gserviceaccount.com",
    "PUBLIC_URL": "https://pub-9785039d4a7e4f76b2446f9fae6b2ca1.r2.dev",
    "FIREBASE_PROJECT_ID": "temp-a1437",
    "FIREBASE_DB_URL": "https://temp-a1437-default-rtdb.firebaseio.com"
  },
  "secrets": {
    "required": [
      "FIREBASE_WEB_API_KEY",
      "GOOGLE_SA_KEY",
      "BOOK_HOMEWORK_GOOGLE_SA_KEY",
      "LISTENING_DELIVERY_SECRET",
      "LISTENING_AUTHORING_IDEMPOTENCY_SECRET",
      "UPLOAD_GRANT_SECRET",
      "EXTERNAL_AUDIO_STORE_SERVICE_ACCOUNT",
      "EXTERNAL_AUDIO_ENCRYPTION_KEYRING"
    ]
  }
}
