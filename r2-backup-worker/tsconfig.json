{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "types": [
            "@cloudflare/workers-types"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "outDir": "./dist",
        "rootDir": "..",
        "lib": [
            "ES2022"
        ]
    },
    "include": [
        "src/**/*.ts",
        "../functions/src/readingV2SubmitCore.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
