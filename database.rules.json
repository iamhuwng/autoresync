{
    "rules": {
        ".read": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
        "users": {
            ".read": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
            "$uid": {
                ".read": "auth != null",
                ".write": "$uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
                "role": {
                    ".validate": "root.child('users').child(auth.uid).child('role').val() === 'super_admin' || ($uid === auth.uid && !data.exists())"
                },
                "status": {
                    ".validate": "root.child('users').child(auth.uid).child('role').val() === 'super_admin' || ($uid === auth.uid && !data.exists())"
                },
                "forceReauth": {
                    ".write": "root.child('users').child(auth.uid).child('role').val() === 'super_admin' || $uid === auth.uid"
                }
            },
            ".indexOn": [
                "email",
                "role",
                "status"
            ]
        },
        "student_teacher_assignments": {
            ".read": "auth != null",
            "$assignmentId": {
                ".read": "data.child('teacherId').val() === auth.uid || data.child('studentId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
                ".write": "root.child('users').child(auth.uid).child('role').val() === 'teacher' || root.child('users').child(auth.uid).child('role').val() === 'super_admin'"
            },
            ".indexOn": [
                "teacherId",
                "studentId",
                "status"
            ]
        },
        "student_teacher_links": {
            ".read": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
            "$teacherId": {
                ".read": "$teacherId === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
                ".write": "root.child('users').child(auth.uid).child('role').val() === 'super_admin' || (root.child('users').child(auth.uid).child('role').val() === 'teacher' && auth.uid === $teacherId)",
                "$studentId": {
                    ".validate": "newData.val() === true || !newData.exists()"
                }
            }
        },
        "assignment_history": {
            ".read": "root.child('users').child(auth.uid).child('role').val() === 'teacher' || root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
            "$historyId": {
                ".write": "root.child('users').child(auth.uid).child('role').val() === 'teacher' || root.child('users').child(auth.uid).child('role').val() === 'super_admin'"
            },
            ".indexOn": [
                "studentId",
                "teacherId",
                "timestamp"
            ]
        },
        "results": {
            ".read": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
            "$resultId": {
                ".read": "data.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'teacher'",
                ".write": "auth != null"
            },
            ".indexOn": [
                "userId",
                "quizId",
                "sessionId"
            ]
        },
        "test_results": {
            ".read": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
            "$resultId": {
                ".read": "data.child('studentId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || (root.child('users').child(auth.uid).child('role').val() === 'teacher' && data.child('visibility').child('ownershipResolved').val() === true && (data.child('visibility').child('visibilityOwnerTeacherId').val() === auth.uid || (data.child('visibility').child('contextType').val() === 'solo_practice' && root.child('student_teacher_links').child(auth.uid).child(data.child('studentId').val()).val() === true)))",
                ".write": "auth != null"
            },
            ".indexOn": [
                "studentId",
                "sessionCode",
                "courseId",
                "classId",
                "moduleId",
                "submittedAt"
            ]
        },
        "test_results_by_teacher": {
            ".read": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
            "$teacherId": {
                ".read": "$teacherId === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
                ".write": "auth != null",
                ".indexOn": [
                    "submittedAt"
                ]
            }
        },
        "test_results_by_student": {
            ".read": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
            "$studentId": {
                ".read": "$studentId === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
                ".write": "$studentId === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
                "$resultId": {
                    ".write": "$studentId === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || (root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('test_results').child($resultId).child('studentId').val() === $studentId && root.child('test_results').child($resultId).child('visibility').child('ownershipResolved').val() === true && root.child('test_results').child($resultId).child('visibility').child('visibilityOwnerTeacherId').val() === auth.uid)"
                },
                ".indexOn": [
                    "submittedAt"
                ]
            }
        },
        "test_results_solo_practice_by_student": {
            ".read": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
            "$studentId": {
                ".read": "$studentId === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || (root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('student_teacher_links').child(auth.uid).child($studentId).val() === true)",
                ".write": "$studentId === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
                "$resultId": {
                    ".write": "$studentId === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
                    ".validate": "!newData.exists() || (newData.hasChildren(['resultId', 'submittedAt']) && newData.child('resultId').val() === $resultId)"
                },
                ".indexOn": [
                    "submittedAt"
                ]
            }
        },
        "test_results_by_session": {
            ".read": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
            "$sessionCode": {
                ".read": "root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('game_sessions').child($sessionCode).child('createdByUserId').val() === auth.uid || root.child('game_sessions').child($sessionCode).child('createdBy').val() === auth.uid",
                ".write": "root.child('users').child(auth.uid).child('role').val() === 'super_admin' || data.child('studentId').val() === auth.uid || newData.child('studentId').val() === auth.uid",
                "$resultId": {
                    ".write": "root.child('users').child(auth.uid).child('role').val() === 'super_admin' || (root.child('test_results').child($resultId).child('sessionCode').val() === $sessionCode && root.child('test_results').child($resultId).child('studentId').val() === auth.uid) || (root.child('users').child(auth.uid).child('role').val() === 'teacher' && root.child('test_results').child($resultId).child('sessionCode').val() === $sessionCode && root.child('test_results').child($resultId).child('visibility').child('ownershipResolved').val() === true && root.child('test_results').child($resultId).child('visibility').child('visibilityOwnerTeacherId').val() === auth.uid)"
                },
                ".indexOn": [
                    "submittedAt"
                ]
            }
        },
        "test_results_by_course": {
            ".read": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
            "$courseId": {
                ".read": "root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('courses').child($courseId).child('ownerId').val() === auth.uid",
                "$studentId": {
                    ".read": "$studentId === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('courses').child($courseId).child('ownerId').val() === auth.uid",
                    ".write": "$studentId === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('courses').child($courseId).child('ownerId').val() === auth.uid",
                    ".indexOn": [
                        "submittedAt"
                    ]
                }
            }
        },
        "test_results_by_class": {
            ".read": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
            "$classId": {
                ".read": "root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('classes').child($classId).child('createdBy').val() === auth.uid",
                "$studentId": {
                    ".read": "$studentId === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('classes').child($classId).child('createdBy').val() === auth.uid",
                    ".write": "$studentId === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('classes').child($classId).child('createdBy').val() === auth.uid",
                    ".indexOn": [
